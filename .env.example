# Copia este archivo a .env.local y rellena los valores reales.
# .env.local nunca se sube al repositorio (ver .gitignore).
#
# Vite solo expone al código de cliente las variables que empiezan con VITE_.
#
# Dónde encontrar estos valores: panel de Supabase del proyecto →
# Project Settings → API. La URL es "Project URL"; la clave es la
# "anon" / "publishable" key — NUNCA la service_role key, que no debe
# salir del servidor.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
